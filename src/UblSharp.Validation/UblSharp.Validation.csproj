<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../build.props" />
  <PropertyGroup>
    <AssemblyName>UblSharp.Validation</AssemblyName>
    <AssemblyTitle>Validate UBL XML documents and .NET types created with UblSharp.</AssemblyTitle>
    <Description>Validate UBL XML documents and .NET types created with UblSharp.</Description>
    <Copyright>Copyright 2017 Remco Ros</Copyright>
    <Authors>Remco Ros</Authors>
    <VersionPrefix>$(UblSharpValidationVersion)</VersionPrefix>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>git://github.com/UblSharp/UblSharp</RepositoryUrl>
    <PackageTags>ubl;ublsharp;ublsharp.validation</PackageTags>
    <PackageProjectUrl>https://github.com/UblSharp/UblSharp</PackageProjectUrl>
    <PackageLicenseUrl>https://github.com/UblSharp/UblSharp/blob/master/LICENSE</PackageLicenseUrl>
    <RootNamespace>UblSharp.Validation</RootNamespace>
    <NeutralLanguage>en-US</NeutralLanguage>
    <TargetFrameworks>net20;net35;net40;net45;netstandard2.0</TargetFrameworks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors>true</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!--
    XSDs are packed at build time into ONE solid gzip archive (xsd.pack.gz) to reduce the assembly size.
    XSD annotations (documentation) are stripped: they are not needed for validation and make up ~80% of the XSD size.
    Archive format: [int count] then per entry [string path ('/' separated, e.g. "maindoc/UBL-Invoice-2.1.xsd")][int length][bytes].
    Read at runtime by Internal/XsdResources.cs.
  -->
  <ItemGroup>
    <XsdSource Include="Resources\**\*.xsd" />
  </ItemGroup>
  <UsingTask TaskName="PackXsd" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        XNamespace xsd = "http://www.w3.org/2001/XMLSchema";
        var settings = new XmlWriterSettings { Indent = false, OmitXmlDeclaration = false, Encoding = new System.Text.UTF8Encoding(false) };
        using (var output = File.Create(OutputFile))
        using (var gzip = new GZipStream(output, CompressionMode.Compress))
        using (var writer = new BinaryWriter(gzip))
        {
            writer.Write(Files.Length);
            foreach (var file in Files)
            {
                var path = (file.GetMetadata("RecursiveDir") + file.GetMetadata("Filename") + file.GetMetadata("Extension")).Replace(Path.DirectorySeparatorChar, '/');
                var doc = XDocument.Load(file.ItemSpec);
                doc.Descendants(xsd + "annotation").ToList().ForEach(e => e.Remove());
                byte[] bytes;
                using (var ms = new MemoryStream())
                {
                    using (var xw = XmlWriter.Create(ms, settings)) { doc.Save(xw); }
                    bytes = ms.ToArray();
                }
                writer.Write(path);
                writer.Write(bytes.Length);
                writer.Write(bytes);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="InitPackXsd">
    <PropertyGroup>
      <XsdPackFile>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)xsd.pack.gz</XsdPackFile>
    </PropertyGroup>
  </Target>
  <Target Name="PackXsd" DependsOnTargets="InitPackXsd" BeforeTargets="AssignTargetPaths" Inputs="@(XsdSource);$(MSBuildProjectFullPath)" Outputs="$(XsdPackFile)">
    <PackXsd Files="@(XsdSource)" OutputFile="$(XsdPackFile)" />
  </Target>
  <Target Name="EmbedPackedXsd" AfterTargets="PackXsd" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <EmbeddedResource Include="$(XsdPackFile)" LogicalName="$(AssemblyName).Resources.xsd.pack.gz" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\UblSharp\UblSharp.csproj" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="4.3.0" />
    <PackageReference Include="System.Xml.XmlSerializer" Version="4.3.0" />
    <PackageReference Include="System.Xml.XmlDocument" Version="4.3.0" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net20' ">
    <FrameworkPathOverride>C:\Windows\Microsoft.NET\Framework\v2.0.50727</FrameworkPathOverride>
    <DefineConstants>$(DefineConstants);NET20;FEATURE_SERIALIZATION;FEATURE_XMLDOCUMENT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net35' ">
    <FrameworkPathOverride>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v3.5\Profile\Client</FrameworkPathOverride>
    <DefineConstants>$(DefineConstants);NET35;FEATURE_LINQ;FEATURE_SERIALIZATION;FEATURE_XMLDOCUMENT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net40' ">
    <DefineConstants>$(DefineConstants);NET40;FEATURE_LINQ;FEATURE_SERIALIZATION;FEATURE_XMLDOCUMENT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net45' ">
    <DefineConstants>$(DefineConstants);NET45;FEATURE_LINQ;FEATURE_SERIALIZATION;FEATURE_XMLDOCUMENT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <DefineConstants>$(DefineConstants);NETSTANDARD2_0;FEATURE_LINQ;FEATURE_SERIALIZATION;FEATURE_XMLDOCUMENT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
  </PropertyGroup>
</Project>
